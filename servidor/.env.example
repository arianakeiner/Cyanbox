# =====================================================================
#  CYANBOX · Servicio de persistencia (API + base de datos)
# =====================================================================
#  Modo de ejecución: prueba | produccion
#  - Si se deja vacío, iniciar.php lo pregunta la primera vez y lo guarda acá.
#  - prueba: todo en este equipo (localhost:8000) con SQLite. NO hace falta completar nada más.
#  - produccion: se usan las variables PROD_* de abajo.
CYANBOX_MODO=

APP_NAME=Cyanbox
APP_KEY=
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# ---------------------------------------------------------------------
#  PRODUCCIÓN (solo se leen si CYANBOX_MODO=produccion)
# ---------------------------------------------------------------------
# Dirección y puerto donde escucha la API. 0.0.0.0 = acepta conexiones de la red.
PROD_SERVIDOR_HOST=0.0.0.0
PROD_SERVIDOR_PUERTO=8000
# URL pública de la API (cómo la ven los clientes), p. ej. http://192.168.0.10:8000
PROD_APP_URL=
# URL de los clientes web que pueden usar la API, separadas por coma (* = cualquiera)
PROD_CLIENTES_PERMITIDOS=*

# Base de datos PostgreSQL (equipo local del restaurante o servidor en la web)
PROD_DB_CONNECTION=pgsql
PROD_DB_HOST=
PROD_DB_PORT=5432
PROD_DB_DATABASE=cyanbox
PROD_DB_USERNAME=
PROD_DB_PASSWORD=

# Usuario administrador inicial que se crea en producción (solo si no existe)
PROD_ADMIN_EMAIL=
PROD_ADMIN_PASSWORD=

# ---------------------------------------------------------------------
#  Ajustes opcionales (valen para ambos modos)
# ---------------------------------------------------------------------
CYANBOX_DURACION_RESERVA_MIN=120
CYANBOX_HORAS_TOKEN=12

# Infraestructura de Laravel (no hace falta tocar)
LOG_CHANNEL=single
LOG_LEVEL=warning
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
