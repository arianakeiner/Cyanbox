# =====================================================================
#  CYANBOX · Servicio cliente (aplicación web para tablets y equipos)
# =====================================================================
#  Modo de ejecución: prueba | produccion
#  - Si se deja vacío, iniciar.mjs lo pregunta la primera vez y lo guarda acá.
#  - prueba: usa el servicio de persistencia de este mismo equipo (http://127.0.0.1:8000).
#            NO hace falta completar nada más.
#  - produccion: se usan las variables PROD_* de abajo.
CYANBOX_MODO=

# ---------------------------------------------------------------------
#  PRODUCCIÓN (solo se leen si CYANBOX_MODO=produccion)
# ---------------------------------------------------------------------
# Dirección del servicio de persistencia (equipo del restaurante o servidor web), con /api al final.
# Ejemplos: http://192.168.0.10:8000/api   ·   https://api.mirestaurante.com/api
PROD_API_URL=
# Dirección y puerto donde se publica la aplicación web. 0.0.0.0 = visible desde otros equipos de la red.
PROD_CLIENTE_HOST=0.0.0.0
PROD_CLIENTE_PUERTO=5173
